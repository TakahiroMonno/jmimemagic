<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="stdout" target="SYSTEM_OUT">
      <PatternLayout pattern="%d [%t] %-5p %c - %m%n"/>
    </Console>
    <RollingFile name="file" fileName="jmimemagic.log" filePattern="jmimemagic.log.%i">
      <PatternLayout pattern="%d [%t] %-5p %c - %m%n"/>
      <Policies>
        <SizeBasedTriggeringPolicy size="10000 KB"/>
      </Policies>
      <DefaultRolloverStrategy max="1" fileIndex="min"/>
    </RollingFile>
  </Appenders>
  <Loggers>
    <Logger name="net.sf.jmimemagic" level="ERROR"/>
    <Root level="ERROR">
      <AppenderRef ref="file"/>
    </Root>
  </Loggers>
</Configuration>
